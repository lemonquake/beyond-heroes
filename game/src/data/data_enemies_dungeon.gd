class_name DataEnemiesDungeon
## bh-012: the 25 monsters of the five dungeons (DataDungeons) — four per theme and each dungeon's boss. Base stats sit
## beside the existing monster of the same role (level scaling does the rest: the dungeons run from level 5 to 25).
## Models: game/assets/characters/<id>.glb (tools/blender/characters/enemy_<id>.py, tools/blender/creatures/build_<id>.py).
## Creature clips carry their own stems: crab_ (Reef Crawler), boar_ (Rootback Boar), hound_ (Slag Hound), weaver_ (Rime
## Weaver). Floating models (Ice Wraith, Starmote) have no clips: the game animates them.

const W := Elements.WATER
const F := Elements.FIRE
const I := Elements.ICE
const E := Elements.EARTH
const L := Elements.LIGHTNING
const D := Elements.DARK
const LT := Elements.LIGHT

static func e(id: StringName, name: String, arche: StringName, d: Dictionary) -> EnemyDef:
	return DataEnemies._e(id, name, arche, d)

static func defs() -> Array:
	return warren() + deeps() + ember() + rime() + orrery()

