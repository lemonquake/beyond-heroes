class_name DataEnemiesZarael
## bh-029: the thirty monsters of Zarael Island (docs/LORE.md §11): the Coilwood, the Glasswire Barrens, the Bridge of
## Death, the Heart Citadel and the three Vaults (DataDungeonsZarael). They live at levels 30-53; base stats sit beside
## the existing monster of the same role and level scaling (CombatBudget) does the rest.
## Families: wirewright (the island's ancient constructs), wiresick (people and beasts the Blackwire changed), kharvenn
## (the chain-priests and their soldiers), gigas (grown from the sleeping giant), jade (the Sepulchre's dead).
## Models: game/assets/characters/<id>.glb (tools/blender/characters/enemy_<id>.py, tools/blender/creatures/build_<id>.py).
## Creature clips carry their own stems: cat_ (Wireback Stalker), scorp_ (Glasswire Scorpion), mhound_ (Marrow Hound),
## beetle_ (Sepulchre Beetle). Floating models (Relay Mote, Ward Eye, Heartwire Wraith) have no clips.

const F := Elements.FIRE
const I := Elements.ICE
const L := Elements.LIGHTNING
const E := Elements.EARTH
const WI := Elements.WIND
const WA := Elements.WATER
const LT := Elements.LIGHT
const D := Elements.DARK

# every Zarael glow is pure white (the user's call, 2 Oct 2026): the corrupted current, the Wirewrights' old current
# still burning in their constructs, and the Sepulchre's wire alike
const BLACKWIRE := MaterialLibrary.ZR_GLOW
const OLDWIRE := MaterialLibrary.ZR_GLOW
const JADEFIRE := MaterialLibrary.ZR_GLOW
const MOLTEN := Color(1.0, 0.5, 0.15)

static func e(id: StringName, name: String, arche: StringName, d: Dictionary) -> EnemyDef:
	return DataEnemies._e(id, name, arche, d)

static func defs() -> Array:
	return coilwood() + barrens() + bridge() + citadel() + jade() + obsidian() + vein()

## Ids of every Zarael monster (tests, the bestiary).
static func ids() -> Array[StringName]:
	var out: Array[StringName] = []
	for d: EnemyDef in defs():
		out.append(d.id)
	return out

