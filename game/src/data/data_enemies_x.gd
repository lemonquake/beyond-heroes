class_name DataEnemiesX
## bh-013: twenty-one new monsters (summoners, splitters, burrowers, tethers, wards, mirrors, twins, mines, gazes, beams),
## four helpers they create, and the bosses of the fifteen new dungeons (DataDungeonsX). Their mechanics live in
## enemy_traits_x.gd; base stats sit beside the existing monster of the same role and level scaling does the rest.
## Models: game/assets/characters/<id>.glb. Creature clip stems: ooze_ (Gloam Ooze), maw_ (Tunnel Maw), basilisk_
## (Stonegaze Basilisk), shell_ (Shellback Grinder). Floating/static models (Hive Drone, Gloomwraith, Prism Sentinel,
## Void Rift, Waxen Hive) have no clips: the game animates their nodes. Bosses reuse a model at boss scale.

const W := Elements.WATER
const F := Elements.FIRE
const I := Elements.ICE
const E := Elements.EARTH
const L := Elements.LIGHTNING
const D := Elements.DARK
const LT := Elements.LIGHT
const P := Elements.PHYSICAL

static func e(id: StringName, name: String, arche: StringName, d: Dictionary) -> EnemyDef:
	return DataEnemies._e(id, name, arche, d)

static func model(id: String) -> String:
	return DataEnemies.CHAR % id

static func defs() -> Array:
	return casters() + warriors() + creatures() + floaters() + helpers() + bosses()

