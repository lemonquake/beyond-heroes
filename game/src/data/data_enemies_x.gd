## Shared boss fields: never elite, big leash, the usual crowd-control immunities.
static func boss(id: StringName, name: String, d: Dictionary) -> EnemyDef:
	var base := {"aggro_range": 30.0, "leash_range": 200.0, "can_be_elite": false, "sight_range": 34.0, "status_res": 0.3, "knockback_res": 0.7,
		"status_immune": [&"frozen", &"stunned", &"petrified", &"feared"], "xp_mult": 25.0, "drop_chance": 1.0, "corpse_time": 60.0}
	base.merge(d, true)
	return e(id, name, &"boss", base)

