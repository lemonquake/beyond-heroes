class_name DataEnemies
## Enemy archetypes across seven families (Bandit, Undead, Corrupted, Ancient Construct, Aether, Beast, Cultist) and
## nine roles (melee grunt, tank, ranged, projectile caster, assassin, brute, support, elite via modifiers, boss).
##
## Attack entry keys: id, anim, range, mult, element, knockback, poise, cooldown, kind (melee | projectile | aoe | dash |
## charge | pools | summon), windup (extra telegraph time), telegraph (circle | cone | line | ring), radius, arc, speed,
## projectile (look), count, spread, status {id: buildup}, self_centered, offset, inner_radius, phase (boss min phase),
## weight (selection weight), min_range.

const CHAR := "res://assets/characters/%s.glb"

static func _e(id: StringName, name: String, arche: StringName, d: Dictionary) -> EnemyDef:
	var e := EnemyDef.new()
	e.id = id
	e.display_name = name
	e.archetype = arche
	e.model = CHAR % id
	for k in d:
		e.set(k, d[k])
	return e

