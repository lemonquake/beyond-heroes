## Elite modifiers: id -> {name, color, desc, mods (StatModifiers), flags, res, element}
static func elite_mods() -> Dictionary:
	return {
		&"flaming": {"name": "Flaming", "color": Color(1.0, 0.45, 0.1), "desc": "Attacks add Fire damage and ignite; leaves burning ground on death.",
			"element": Elements.FIRE, "flags": {&"burn_on_hit": 1.0, &"death_fire": 1.0}, "res": {Elements.FIRE: 0.5}},
		&"frozen": {"name": "Frozen", "color": Color(0.55, 0.9, 1.0), "desc": "Attacks Chill; periodically releases a frost pulse.",
			"element": Elements.ICE, "flags": {&"frost_pulse": 1.0}, "res": {Elements.ICE: 0.5}},
		&"storm": {"name": "Storm", "color": Color(0.95, 0.9, 0.35), "desc": "Being hit releases sparks that seek you.",
			"element": Elements.LIGHTNING, "flags": {&"sparks": 1.0}, "res": {Elements.LIGHTNING: 0.5}},
		&"earthen": {"name": "Earthen", "color": Color(0.78, 0.58, 0.3), "desc": "Stomps break your armor; very hard to stagger.",
			"element": Elements.EARTH, "flags": {&"armor_break_hit": 1.0}, "res": {Elements.EARTH: 0.5}, "mods": [StatModifier.more(&"poise", 1.0)]},
		&"vampiric": {"name": "Vampiric", "color": Color(0.85, 0.1, 0.2), "desc": "Heals for 40% of damage dealt.", "flags": {&"leech": 0.4}},
		&"regenerating": {"name": "Regenerating", "color": Color(0.4, 0.95, 0.45), "desc": "Regenerates 3% of HP per second unless Purged or recently burned.",
			"flags": {&"regen": 0.03}},
		&"armored": {"name": "Armored", "color": Color(0.7, 0.72, 0.78), "desc": "Greatly increased Defense and knockback resistance.",
			"mods": [StatModifier.inc(&"defense", 1.0), StatModifier.flat(&"knockback_res", 0.3)]},
		&"swift": {"name": "Swift", "color": Color(0.8, 1.0, 0.8), "desc": "Moves and attacks much faster.",
			"mods": [StatModifier.more(&"move_speed", 0.35), StatModifier.more(&"attack_speed", 0.3)]},
		&"berserker": {"name": "Berserker", "color": Color(1.0, 0.3, 0.15), "desc": "Grows stronger and faster as it loses HP (up to 60% more damage).",
			"flags": {&"berserk": 0.6}},
		&"shielded": {"name": "Shielded", "color": Color(0.55, 0.65, 1.0), "desc": "A ward absorbs damage equal to 50% of its HP; Light damage breaks it twice as fast.",
			"flags": {&"ward": 0.5}},
		&"cursed": {"name": "Cursed", "color": Color(0.6, 0.25, 0.9), "desc": "Its hits Curse you and Weaken your attacks.",
			"element": Elements.DARK, "flags": {&"curse_on_hit": 1.0}, "res": {Elements.DARK: 0.5}},
		&"aether_infused": {"name": "Aether-infused", "color": Color(0.55, 0.98, 1.0), "desc": "Blinks to your side and fires Aether bolts. Drops Aether shards.",
			"element": Elements.LIGHT, "flags": {&"aether_blink": 1.0, &"aether_bolts": 1.0}, "res": {Elements.LIGHT: 0.3, Elements.DARK: 0.3}},
		&"explosive": {"name": "Volatile", "color": Color(1.0, 0.6, 0.2), "desc": "Explodes shortly after death.", "flags": {&"explode": 1.0}},
	}

