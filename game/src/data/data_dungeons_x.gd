const ORDER: Array[StringName] = [&"cellars", &"burrows", &"ossuary", &"warcamp", &"hive", &"sump", &"briar", &"dunemourn",
	&"thunderwell", &"undercroft", &"geode", &"vault", &"reliquary", &"wyrmcoil", &"maw"]

## The fifteen dungeons with their generated floors merged in.
static func list() -> Dictionary:
	var out := {}
	for id in ORDER:
		var d: Dictionary = (LIST[id] as Dictionary).duplicate()
		d["floors"] = DataDungeonPlans.PLANS.get(id, [])
		out[id] = d
	return out
