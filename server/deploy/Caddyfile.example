# Draft for a new Linux VPS. Replace the hostname and validate on that host.
# The public certificate is managed by Caddy; the private loopback service
# retains its existing localhost certificate for the Godot coordinator.
game.example.com {
    @internal path /internal /internal/*
    respond @internal "Not found" 404

    reverse_proxy https://127.0.0.1:8443 {
        header_up -X-Server-Key
        transport http {
            tls_trust_pool file /etc/beyond-heroes/upstream.crt
            tls_server_name localhost
        }
    }
}
