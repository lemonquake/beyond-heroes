# Public client endpoint, written for you by `python -m server.setup_server --public-host ...` as <data dir>/official.cfg.
# Copy it to game/server/official.cfg before exporting the client. Normal certificate trust: `certificate` stays empty.
# Never put the loopback certificate, its key or the internal server key in a client build.
[server]
url="https://game.example.com"
certificate=""
